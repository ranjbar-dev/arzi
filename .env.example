# Database
# POSTGRES_USER owns the tables and runs migrations (DATABASE_URL). It must
# stay out of the API's request path — Postgres superusers always bypass RLS
# and cannot have that revoked, so RLS would be decorative if the API used it.
POSTGRES_USER=arzi
POSTGRES_PASSWORD=change_me
POSTGRES_DB=arzi
POSTGRES_PORT=5432
DATABASE_URL=postgres://arzi:change_me@db:5432/arzi

# APP_DB_USER is a non-superuser, non-BYPASSRLS role (created at db init time
# by db/init/01-app-role.sh) that the API uses for every request — this is
# the role step 1.1's RLS policies actually gate.
APP_DB_USER=arzi_app
APP_DB_PASSWORD=change_me_too
APP_DATABASE_URL=postgres://arzi_app:change_me_too@db:5432/arzi

# API
API_PORT=8080

# Web
WEB_PORT=3000
# Server-only (no NEXT_PUBLIC_ prefix — the browser never talks to the API
# directly). Next.js server code (Server Components/Actions, and the
# next.config.ts rewrite that proxies client-side TanStack Query calls) uses
# this to reach the Rust API. `api` is the docker-compose service name; when
# running `next dev` outside Docker, use http://localhost:8080 instead.
API_INTERNAL_URL=http://api:8080

# api/src/auth/mod.rs's session cookie's `Secure` flag. Must be `false` for
# any plain-HTTP origin (this whole docker-compose stack today) — browsers
# silently refuse to store a `Secure` cookie over HTTP, which breaks login
# outright. Flip to `true` only once the deployment actually terminates TLS
# (step 7.4).
SESSION_COOKIE_SECURE=false

# Production only (docker-compose.prod.yml's `caddy` service + repo-root Caddyfile). Your real
# public domain(s), space-separated for more than one — Caddy treats a space-separated site
# address list as one block serving all of them, so apex + www share this single line. For
# automatic Let's Encrypt TLS. Unset/localhost -> Caddy issues a self-signed cert from its own
# internal CA instead (fine for local prod-shape testing, not for real traffic).
SITE_DOMAIN=ranjbar.dev www.ranjbar.dev
