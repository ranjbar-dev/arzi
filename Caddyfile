{
	# Caddy auto-detects a non-public address (localhost, an IP, .local) and issues a
	# self-signed cert from its own internal CA instead of attempting Let's Encrypt against
	# it — so this file works unmodified for local prod-shape testing (SITE_DOMAIN unset,
	# defaults to localhost) and for real deployment (SITE_DOMAIN set to a real domain,
	# automatic Let's Encrypt kicks in) with no config branching.
}

{$SITE_DOMAIN:localhost} {
	reverse_proxy web:3000
}
